[Unit]
Description=Vanguard : mettre à jour les images Linux de la clé VANGUARD au branchement
# Copie sur la clé les images neuves du cache (vanguard-images.service), seulement pour celles qu'elle a déjà ; après
# vanguard-cle.service, qui met Vanguard à jour sur la même clé (les deux prennent le même verrou). Puis la version de
# Ventoy sur la clé : plus ancienne que celle épinglée, sa mise à jour est proposée (cle-secours.sh --a-jour).
# Sans le réglage local de la clé de secours (CLE_SECOURS=oui, voir images-cle.sh), rien n'est cherché ni copié :
# la clé ne porte que le programme.
After=run-media-%u-VANGUARD.mount vanguard-cle.service

[Service]
Type=oneshot
# Deux étapes qui ne s'empêchent pas : une copie ratée (déjà dite par sa notification) ne saute pas la vérification de
# Ventoy et de Windows 11, comme dans maj-cle.sh (un ExecStartPost ne part qu'après un ExecStart réussi).
ExecStart=-%h/Projects/vanguard/outils/images-cle.sh --cle
ExecStart=-%h/Projects/vanguard/outils/cle-secours.sh --a-jour
# Une image de 1,5 Go s'écrit en une ou deux minutes sur une clé USB 3 ; bien plus sur une clé lente, et Kali Linux
# (16 Gio, écrite puis relue) près d'une demi-heure. La proposition de Ventoy attend une réponse un quart d'heure.
TimeoutStartSec=3h
Nice=10

[Install]
WantedBy=run-media-%u-VANGUARD.mount
